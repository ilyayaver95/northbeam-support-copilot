# Copy to .env and set the key for whichever provider LLM_MODEL points at.
# litellm resolves the provider from the LLM_MODEL prefix, so switching is a
# one-line change.
#
#   OpenAI     LLM_MODEL=gpt-4o-mini                            OPENAI_API_KEY=...
#   Anthropic  LLM_MODEL=anthropic/claude-haiku-4-5-20251001    ANTHROPIC_API_KEY=...
#   Gemini     LLM_MODEL=gemini/gemini-2.0-flash                GEMINI_API_KEY=...
#   Groq       LLM_MODEL=groq/llama-3.3-70b-versatile           GROQ_API_KEY=...

LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-...

# Optional
# ANSWER_CACHE=0              bypass the answer cache; every question hits the model
# TRACE_LOG=0                 turn off trace writing
# TRACE_LOG_PATH=./t.jsonl    write traces somewhere else
# SYSTEM_VERSION=my-branch    tag traces and eval runs for A/B comparison
